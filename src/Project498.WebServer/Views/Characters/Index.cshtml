@model List<Project498.WebServer.Services.DcCharacterDto>

@{
    ViewData["Title"] = "DC Characters";
}

<section class="dc-hero">
    <h1>DC Characters</h1>
    <p>Explore characters from the DC Comics API.</p>
</section>

@if (Model == null || !Model.Any())
{
    <div class="empty-state">
        No characters found. Make sure the DC API is running.
    </div>
}
else
{
    <div class="dc-grid">
        @foreach (var character in Model)
        {
            <article class="dc-card">
                @if (!string.IsNullOrWhiteSpace(character.ImagePath))
                {
                    <img src="@character.ImagePath"
                         alt="@character.Alias"
                         class="dc-card-img" />
                }

                <div class="dc-card-body">
                    <h2>@character.Alias</h2>
                    <h3>@character.Name</h3>

                    <p>
                        @(string.IsNullOrWhiteSpace(character.Description)
                            ? "No description available."
                            : character.Description)
                    </p>

                    <a asp-controller="Characters"
                       asp-action="Details"
                       asp-route-id="@character.CharacterId"
                       class="dc-btn">
                        View Details
                    </a>
                </div>
            </article>
        }
    </div>
}
