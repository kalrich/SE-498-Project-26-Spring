@model Project498.WebServer.Models.Comic
@using Project498.WebServer.Services

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCheckout = ViewBag.ActiveCheckout as CheckoutDto;
    var isCheckedOut = ViewBag.IsCheckedOut as bool? ?? activeCheckout != null;
    var activeCheckoutDueDate = ViewBag.ActiveCheckoutDueDate as DateTime?;
    var isFavorite = ViewBag.IsFavorite as bool? ?? false;
    var reviews = ViewBag.Reviews as List<ComicReviewDto> ?? new List<ComicReviewDto>();
    var userReview = ViewBag.UserReview as ComicReviewDto;
}

<section class="comic-detail-page">
    <div class="comic-detail-grid">
        <div class="comic-detail-cover-panel">
            <div class="comic-detail-cover">
                <img src="@Model.CoverImagePath" alt="@Model.Title" class="cover-image" />
            </div>
        </div>

        <div class="comic-detail-info">
            <p class="comic-detail-author">@Model.Author</p>
            <h1 class="comic-detail-title">@Model.Title</h1>

            <div class="pill-row comic-detail-pills">
                <span class="pill">@Model.Genre</span>
                @if (!string.IsNullOrWhiteSpace(Model.SecondaryGenre))
                {
                    <span class="pill">@Model.SecondaryGenre</span>
                }
            </div>

            <div class="rating-summary">
                <span>@(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "No ratings yet")</span>
                @if (Model.ReviewCount > 0)
                {
                    <span class="rating-stars">★★★★★</span>
                    <span class="rating-count">@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s")</span>
                }
            </div>

            <p class="comic-detail-description">
                @Model.Description
            </p>

            <div class="comic-detail-actions">
                <form method="post" action="/Comics/ToggleFavorite">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="isFavorite" value="@isFavorite.ToString().ToLower()" />
                    <button type="submit" class="btn btn-light detail-btn">
                        @(isFavorite ? "Remove Favorite" : "Add Favorite")
                    </button>
                </form>

                @if (isCheckedOut)
                {
                    <a href="/Reader/Index?id=@Model.Id" class="btn btn-dark detail-btn">Read Now</a>
                }
                else
                {
                    <a href="@Url.Action("Initiate", "Checkout", new { comicId = Model.Id })"
                       class="btn btn-dark detail-btn">Checkout Comic</a>
                }
                <a href="/Checkout/Active" class="btn btn-light detail-btn">My Checkouts</a>
            </div>

            <div class="comic-detail-meta-box">
                <div class="comic-meta-row">
                    <span class="comic-meta-label">Status</span>
                    <span class="comic-meta-value">
                        @(isCheckedOut ? "Checked Out" : "Available to Checkout")
                    </span>
                </div>
                @if (isCheckedOut)
                {
                    <div class="comic-meta-row">
                        <span class="comic-meta-label">Due Date</span>
                        <span class="comic-meta-value">
                            @((activeCheckoutDueDate ?? activeCheckout?.DueDate)?.ToString("MMM dd, yyyy"))
                        </span>
                    </div>
                }
            </div>
            
        </div>
    </div>

    <section class="reviews-section">
        <div class="section-row">
            <h2>Reviews</h2>
        </div>

        <form method="post" action="/Comics/SaveReview" class="review-form">
            <input type="hidden" name="id" value="@Model.Id" />

            <label for="rating">Your rating</label>
            <select id="rating" name="rating" class="explore-select review-rating">
                @for (var rating = 5; rating >= 1; rating--)
                {
                    <option value="@rating" selected="@(userReview?.Rating == rating)">
                        @rating star@(rating == 1 ? "" : "s")
                    </option>
                }
            </select>

            <label for="comment">Your review</label>
            <textarea id="comment" name="comment" class="review-textarea" rows="4">@userReview?.Comment</textarea>

            <button type="submit" class="btn btn-dark detail-btn">Save Review</button>
        </form>

        @if (!reviews.Any())
        {
            <div class="empty-state review-empty">
                <h3>No reviews yet</h3>
                <p>Be the first to rate this comic.</p>
            </div>
        }
        else
        {
            <div class="review-list">
                @foreach (var review in reviews)
                {
                    <article class="review-card">
                        <div class="review-header">
                            <strong>@review.Username</strong>
                            <span>@review.Rating/5</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p>@review.Comment</p>
                        }
                    </article>
                }
            </div>
        }
    </section>

</section>
