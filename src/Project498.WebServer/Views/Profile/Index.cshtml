@model Project498.WebServer.Models.ProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var initials = string.Join("", Model.Username
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(x => x[0]))
        .ToUpper();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "U";
    }
}

<section class="profile-page">
    <div class="profile-header">
        <h1>My Profile</h1>
        <p>View and update your account information.</p>
    </div>

    <div class="profile-grid">
        <div class="profile-card main-profile-card">
            <div class="profile-avatar-large">@initials</div>

            <div class="profile-info-block">
                <h2>@Model.Username</h2>
                <p class="profile-email">@Model.Email</p>
                <p class="profile-stat">Total Books Read: <strong>@Model.TotalBooksRead</strong></p>
            </div>
        </div>

        <div class="profile-card">
            <h3>Edit Account</h3>

            @if (ViewBag.Success != null)
            {
                <p class="success-text">@ViewBag.Success</p>
            }

            @if (ViewBag.Error != null)
            {
                <p class="error-text">@ViewBag.Error</p>
            }

            <form method="post" asp-controller="Profile" asp-action="Index" class="profile-form">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" />
                <span asp-validation-for="Username" class="error-text"></span>

                <label asp-for="Email">Email</label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="error-text"></span>

                <label asp-for="Password">New Password</label>
                <input asp-for="Password" type="password" placeholder="Leave blank to keep current password" />
                <span asp-validation-for="Password" class="error-text"></span>

                <div class="profile-form-actions">
                    <button type="submit" class="btn btn-dark detail-btn">Save Changes</button>
                </div>
            </form>
        </div>

        <div class="profile-card">
            <h3>Reading Activity</h3>

            <div class="profile-detail-row">
                <span class="profile-label">Total Books Read</span>
                <span class="profile-value">@Model.TotalBooksRead</span>
            </div>

            <div class="profile-detail-row">
                <span class="profile-label">Account Type</span>
                <span class="profile-value">Marvel·ous Reads User</span>
            </div>

            <div class="profile-detail-row">
                <span class="profile-label">Favorites</span>
                <span class="profile-value">@Model.Favorites.Count</span>
            </div>

            <div class="profile-detail-row">
                <span class="profile-label">Reviews</span>
                <span class="profile-value">@Model.Reviews.Count</span>
            </div>
        </div>

        <div class="profile-card profile-wide-card">
            <h3>Favorites</h3>

            @if (!Model.Favorites.Any())
            {
                <p class="profile-empty-text">No favorites yet.</p>
            }
            else
            {
                <div class="profile-comic-list">
                    @foreach (var comic in Model.Favorites)
                    {
                        <a href="/Comics/Details?id=@comic.Id" class="profile-comic-row">
                            <img src="@comic.CoverImagePath" alt="@comic.Title" class="profile-comic-cover" />
                            <div>
                                <strong>@comic.Title</strong>
                                <span>@comic.Author</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="profile-card profile-wide-card">
            <h3>Recently Read</h3>

            @if (!Model.ReadingHistory.Any())
            {
                <p class="profile-empty-text">No reading history yet.</p>
            }
            else
            {
                <div class="profile-comic-list">
                    @foreach (var item in Model.ReadingHistory)
                    {
                        <a href="/Reader/Index?id=@item.ComicId" class="profile-comic-row">
                            <img src="@item.CoverImagePath" alt="@item.Title" class="profile-comic-cover" />
                            <div>
                                <strong>@item.Title</strong>
                                <span>Page @item.CurrentPage · @item.ProgressPercent%</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="profile-card profile-wide-card">
            <h3>My Reviews</h3>

            @if (!Model.Reviews.Any())
            {
                <p class="profile-empty-text">No reviews yet.</p>
            }
            else
            {
                <div class="profile-review-list">
                    @foreach (var review in Model.Reviews)
                    {
                        <a href="/Comics/Details?id=@review.ComicId" class="profile-review-card">
                            @if (!string.IsNullOrWhiteSpace(review.CoverImagePath))
                            {
                                <img src="@review.CoverImagePath" alt="@review.ComicTitle" class="profile-comic-cover" />
                            }
                            <div>
                                <div class="profile-review-heading">
                                    <strong>@review.ComicTitle</strong>
                                    <span>@review.Rating/5</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <p>@review.Comment</p>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>
